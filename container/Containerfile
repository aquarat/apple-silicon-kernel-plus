# Fedora 44 with the tools of container/install-tools.sh.
# Used by scripts/build-srpms.sh:  docker build -t askp-tools:44 -f container/Containerfile container
FROM registry.fedoraproject.org/fedora:44
COPY install-tools.sh /usr/local/sbin/install-tools.sh
RUN /usr/local/sbin/install-tools.sh
