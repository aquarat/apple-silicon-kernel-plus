# Tools to build this project's SRPMs and lint the specs and scripts, on
# Fedora 44. Used by scripts/build-srpms.sh and by the GitHub workflows.
# The compiler and kernel tools are only for the kernel prep check
# (rpmbuild -bp: do the patches apply?).
FROM registry.fedoraproject.org/fedora:44
RUN dnf -y install --setopt=install_weak_deps=False \
        rpm-build rpmdevtools rpmlint cpio xz zstd bzip2 tar gzip \
        git-core curl ca-certificates python3 make patch diffutils findutils \
        meson ninja-build cargo rust ShellCheck \
        python3-rpm-macros systemd-rpm-macros gcc flex bison bc perl-interpreter openssl-devel \
        elfutils-libelf-devel dwarves hostname kmod which openssl \
    && dnf clean all
