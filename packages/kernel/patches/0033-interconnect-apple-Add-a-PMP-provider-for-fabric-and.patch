 drivers/interconnect/Makefile        |   1 +
 drivers/interconnect/apple/Kconfig   |  12 ++
 drivers/interconnect/apple/Makefile  |   2 +
 drivers/interconnect/apple/pmp-icc.c | 244 +++++++++++++++++++++++++++
 drivers/pmdomain/apple/pmp-report.c  |  17 ++
 include/linux/soc/apple/pmp-icc.h    |  20 +++
 7 files changed, 297 insertions(+)
 create mode 100644 drivers/interconnect/apple/Kconfig
 create mode 100644 drivers/interconnect/apple/Makefile
 create mode 100644 drivers/interconnect/apple/pmp-icc.c
 create mode 100644 include/linux/soc/apple/pmp-icc.h

