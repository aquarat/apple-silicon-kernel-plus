diff --git a/drivers/soc/apple/cpu-memvote.c b/drivers/soc/apple/cpu-memvote.c
new file mode 100644
index 000000000..9e8940cdf
--- /dev/null
+++ b/drivers/soc/apple/cpu-memvote.c
@@ -0,0 +1,410 @@
+// SPDX-License-Identifier: GPL-2.0-only OR MIT
+/*
+ * Apple SoC CPU cluster memory-bandwidth votes
+ *
+ * With the PMP running, the fabric and DRAM controller follow the agents'
+ * requests; the CPU clusters have their own request slots, and without a
+ * request a streaming CPU gets the lowest fabric/DCS levels: half the
+ * memory bandwidth of a machine without the PMP. Holding a request all
+ * the time costs ~2.4 W under compute-bound load on an M1 Max, and nothing
+ * at idle, so the request has to follow memory demand, not CPU load.
+ *
+ * Every period_ms this driver looks at each CPU that was busy for at least
+ * busy_pct of the period at no less than freq_pct of its maximum
+ * frequency, and counts its L1D load misses per 1000 active cycles (CPU
+ * PMU). A cluster with min_cpus such CPUs at or above mpkc misses asks the
+ * interconnect for bw_kbps; it drops the request hold_ms after the last
+ * such sample. Idle CPUs are not touched.
+ *
+ * "mode" switches between auto (the above), off (no requests) and force
+ * (always request), for A/B measurements.
+ *
+ * The interconnect provider registers this device when it has the CPU
+ * clusters' nodes (t6000/t6001).
+ */
+
+#include <linux/cpufreq.h>
+#include <linux/cpumask.h>
+#include <linux/interconnect.h>
+#include <linux/ktime.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/perf_event.h>
+#include <linux/platform_device.h>
+#include <linux/slab.h>
+#include <linux/soc/apple/pmp-icc.h>
+#include <linux/soc/apple/pmp-report.h>
+#include <linux/workqueue.h>
+
+#define MEMVOTE_MAX_CLUSTERS	3
+
+/* Asahi's apple_m1_cpu_pmu event numbers */
+#define M1_PMU_CORE_ACTIVE_CYCLE	0x02
+#define M1_PMU_L1D_CACHE_MISS_LD	0xa3
+
+enum { MEMVOTE_OFF, MEMVOTE_AUTO, MEMVOTE_FORCE };
+static const char * const memvote_modes[] = { "off", "auto", "force" };
+
+static int mode = MEMVOTE_AUTO;
+static unsigned int period_ms = 10;
+static unsigned int hold_ms = 100;
+static unsigned int busy_pct = 50;
+static unsigned int freq_pct = 60;
+static unsigned int mpkc = 10;
+static unsigned int min_cpus = 1;
+static unsigned int bw_kbps = 200000000;
+
+static DEFINE_MUTEX(memvote_active_lock);
+static struct memvote *memvote_active;
+static void memvote_kick(struct memvote *mv);
+
+static int mode_set(const char *val, const struct kernel_param *kp)
+{
+	int i = sysfs_match_string(memvote_modes, val);
+
+	if (i < 0)
+		return i;
+	WRITE_ONCE(mode, i);
+	/* act on the new mode now, not at the next (up to 1 s) sample */
+	mutex_lock(&memvote_active_lock);
+	if (memvote_active)
+		memvote_kick(memvote_active);
+	mutex_unlock(&memvote_active_lock);
+	return 0;
+}
+
+static int mode_get(char *buf, const struct kernel_param *kp)
+{
+	return sysfs_emit(buf, "%s\n", memvote_modes[READ_ONCE(mode)]);
+}
+
+static const struct kernel_param_ops mode_ops = { .set = mode_set, .get = mode_get };
+module_param_cb(mode, &mode_ops, NULL, 0644);
+MODULE_PARM_DESC(mode, "auto (follow memory demand, default), off, force");
+module_param(period_ms, uint, 0644);
+MODULE_PARM_DESC(period_ms, "sampling period (ms)");
+module_param(hold_ms, uint, 0644);
+MODULE_PARM_DESC(hold_ms, "keep a request this long after the last memory-bound sample (ms)");
+module_param(busy_pct, uint, 0644);
+MODULE_PARM_DESC(busy_pct, "a CPU counts only if busy for this % of the period");
+module_param(freq_pct, uint, 0644);
+MODULE_PARM_DESC(freq_pct, "... at this % of its maximum frequency or more");
+module_param(mpkc, uint, 0644);
+MODULE_PARM_DESC(mpkc, "... with this many L1D load misses per 1000 active cycles or more");
+module_param(min_cpus, uint, 0644);
+MODULE_PARM_DESC(min_cpus, "memory-bound CPUs a cluster needs to request bandwidth");
+module_param(bw_kbps, uint, 0644);
+MODULE_PARM_DESC(bw_kbps, "bandwidth a memory-bound cluster requests (kB/s)");
+
+struct memvote_cluster {
+	struct icc_path *path;
+	unsigned int first_cpu;
+	bool high;
+	ktime_t last_busy;
+	u64 ups;
+	u64 ms_high;
+	ktime_t t_high;
+};
+
+struct memvote_cpu {
+	struct perf_event *cyc, *miss;
+	u64 prev_cyc, prev_miss, prev_idle, prev_wall;
+	int cluster;
+};
+
+struct memvote {
+	struct device *dev;
+	struct device *report;
+	struct delayed_work work;
+	struct mutex lock;
+	struct memvote_cluster cl[MEMVOTE_MAX_CLUSTERS];
+	unsigned int n_cl;
+	struct memvote_cpu __percpu *cpu;
+	bool have_pmu;
+};
+
+static const char * const memvote_nodes[MEMVOTE_MAX_CLUSTERS] = {
+	APPLE_PMP_ICC_CPU_CLUSTER0, APPLE_PMP_ICC_CPU_CLUSTER1, APPLE_PMP_ICC_CPU_CLUSTER2,
+};
+
+static void memvote_set(struct memvote *mv, struct memvote_cluster *c, bool high)
+{
+	if (c->high == high)
+		return;
+	if (icc_set_bw(c->path, 0, high ? bw_kbps : 0))
+		return;
+	c->high = high;
+	if (high) {
+		c->ups++;
+		c->t_high = ktime_get();
+	} else {
+		c->ms_high += ktime_ms_delta(ktime_get(), c->t_high);
+	}
+}
+
+static bool memvote_cpu_bound(struct memvote *mv, unsigned int cpu)
+{
+	struct memvote_cpu *mc = per_cpu_ptr(mv->cpu, cpu);
+	u64 wall, idle = get_cpu_idle_time(cpu, &wall, 0);
+	u64 dw = wall - mc->prev_wall, di = idle - mc->prev_idle;
+	struct cpufreq_policy *pol;
+	u64 en, run, cyc, miss, dc, dm;
+	unsigned int cur, max;
+
+	mc->prev_wall = wall;
+	mc->prev_idle = idle;
+	if (!dw || di > dw || (dw - di) * 100 < (u64)busy_pct * dw)
+		return false;
+
+	pol = cpufreq_cpu_get(cpu);
+	if (!pol)
+		return false;
+	cur = pol->cur;
+	max = pol->cpuinfo.max_freq;
+	cpufreq_cpu_put(pol);
+	if ((u64)cur * 100 < (u64)freq_pct * max)
+		return false;
+
+	/* without counters, never guess: a wrong "yes" costs watts */
+	if (!mc->cyc || !mc->miss)
+		return false;
+	cyc = perf_event_read_value(mc->cyc, &en, &run);
+	miss = perf_event_read_value(mc->miss, &en, &run);
+	dc = cyc - mc->prev_cyc;
+	dm = miss - mc->prev_miss;
+	mc->prev_cyc = cyc;
+	mc->prev_miss = miss;
+	return dc && dm * 1000 >= (u64)mpkc * dc;
+}
+
+static void memvote_work(struct work_struct *work)
+{
+	struct memvote *mv = container_of(work, struct memvote, work.work);
+	unsigned int bound[MEMVOTE_MAX_CLUSTERS] = { 0 };
+	int m = READ_ONCE(mode);
+	ktime_t now = ktime_get();
+	unsigned int cpu, i;
+	unsigned long delay = msecs_to_jiffies(max(period_ms, 1U));
+
+	mutex_lock(&mv->lock);
+	if (!apple_pmp_dvfs_ready(mv->report) || m == MEMVOTE_OFF) {
+		for (i = 0; i < mv->n_cl; i++)
+			memvote_set(mv, &mv->cl[i], false);
+		/* nothing to vote to, or switched off: look again in a second */
+		delay = HZ;
+		goto out;
+	}
+	if (m == MEMVOTE_FORCE) {
+		for (i = 0; i < mv->n_cl; i++)
+			memvote_set(mv, &mv->cl[i], true);
+		delay = HZ;
+		goto out;
+	}
+
+	cpus_read_lock();
+	for_each_online_cpu(cpu) {
+		int c = per_cpu_ptr(mv->cpu, cpu)->cluster;
+
+		if (c >= 0 && memvote_cpu_bound(mv, cpu))
+			bound[c]++;
+	}
+	cpus_read_unlock();
+
+	for (i = 0; i < mv->n_cl; i++) {
+		struct memvote_cluster *c = &mv->cl[i];
+
+		if (bound[i] >= min_cpus) {
+			c->last_busy = now;
+			memvote_set(mv, c, true);
+		} else if (c->high && ktime_ms_delta(now, c->last_busy) >= hold_ms) {
+			memvote_set(mv, c, false);
+		}
+	}
+out:
+	mutex_unlock(&mv->lock);
+	queue_delayed_work(system_freezable_wq, &mv->work, delay);
+}
+
+static void memvote_kick(struct memvote *mv)
+{
+	mod_delayed_work(system_freezable_wq, &mv->work, 0);
+}
+
+static ssize_t stats_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct memvote *mv = dev_get_drvdata(dev);
+	ssize_t n = 0;
+	unsigned int i;
+
+	mutex_lock(&mv->lock);
+	for (i = 0; i < mv->n_cl; i++) {
+		struct memvote_cluster *c = &mv->cl[i];
+		u64 ms = c->ms_high + (c->high ? ktime_ms_delta(ktime_get(), c->t_high) : 0);
+
+		n += sysfs_emit_at(buf, n, "cluster%u cpu%u high %d ups %llu ms_high %llu\n",
+				   i, c->first_cpu, c->high, c->ups, ms);
+	}
+	n += sysfs_emit_at(buf, n, "pmu %d pmp %d\n", mv->have_pmu,
+			   apple_pmp_dvfs_ready(mv->report));
+	mutex_unlock(&mv->lock);
+	return n;
+}
+static DEVICE_ATTR_RO(stats);
+
+static struct attribute *memvote_attrs[] = {
+	&dev_attr_stats.attr,
+	NULL
+};
+ATTRIBUTE_GROUPS(memvote);
+
+static struct perf_event *memvote_counter(unsigned int cpu, u64 config)
+{
+	struct perf_event_attr attr = {
+		.type = PERF_TYPE_RAW,
+		.size = sizeof(attr),
+		.config = config,
+		.pinned = 1,
+	};
+	struct perf_event *e = perf_event_create_kernel_counter(&attr, cpu, NULL, NULL, NULL);
+
+	return IS_ERR(e) ? NULL : e;
+}
+
+static void memvote_free(struct memvote *mv)
+{
+	unsigned int cpu, i;
+
+	for (i = 0; i < mv->n_cl; i++)
+		if (!IS_ERR_OR_NULL(mv->cl[i].path))
+			icc_put(mv->cl[i].path);
+	for_each_possible_cpu(cpu) {
+		struct memvote_cpu *mc = per_cpu_ptr(mv->cpu, cpu);
+
+		if (mc->cyc)
+			perf_event_release_kernel(mc->cyc);
+		if (mc->miss)
+			perf_event_release_kernel(mc->miss);
+	}
+}
+
+static int memvote_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct memvote *mv;
+	unsigned int cpu, i;
+	int ret;
+
+	mv = devm_kzalloc(dev, sizeof(*mv), GFP_KERNEL);
+	if (!mv)
+		return -ENOMEM;
+	mv->dev = dev;
+	/* parent: the apple-pmp-icc provider; its parent: the PMP report device */
+	if (!dev->parent || !dev->parent->parent)
+		return -ENODEV;
+	mv->report = dev->parent->parent;
+	mutex_init(&mv->lock);
+	mv->cpu = devm_alloc_percpu(dev, struct memvote_cpu);
+	if (!mv->cpu)
+		return -ENOMEM;
+	for_each_possible_cpu(cpu)
+		per_cpu_ptr(mv->cpu, cpu)->cluster = -1;
+
+	/* clusters = cpufreq policies in order of their first CPU */
+	for_each_possible_cpu(cpu) {
+		struct cpufreq_policy *pol = cpufreq_cpu_get(cpu);
+		unsigned int first, c;
+
+		if (!pol)
+			return dev_err_probe(dev, -EPROBE_DEFER, "no cpufreq policy for cpu%u\n", cpu);
+		first = cpumask_first(pol->related_cpus);
+		cpufreq_cpu_put(pol);
+		for (c = 0; c < mv->n_cl && mv->cl[c].first_cpu != first; c++)
+			;
+		if (c == mv->n_cl) {
+			if (c >= MEMVOTE_MAX_CLUSTERS)
+				return dev_err_probe(dev, -ENODEV, "more than %d clusters\n",
+						     MEMVOTE_MAX_CLUSTERS);
+			mv->cl[c].first_cpu = first;
+			mv->n_cl++;
+		}
+		per_cpu_ptr(mv->cpu, cpu)->cluster = c;
+	}
+
+	for (i = 0; i < mv->n_cl; i++) {
+		mv->cl[i].path = icc_get(dev, memvote_nodes[i], APPLE_PMP_ICC_DRAM);
+		if (IS_ERR_OR_NULL(mv->cl[i].path)) {
+			ret = mv->cl[i].path ? PTR_ERR(mv->cl[i].path) : -ENODEV;
+			mv->cl[i].path = NULL;
+			memvote_free(mv);
+			return dev_err_probe(dev, ret, "no interconnect path for cluster %u\n", i);
+		}
+	}
+
+	mv->have_pmu = true;
+	for_each_online_cpu(cpu) {
+		struct memvote_cpu *mc = per_cpu_ptr(mv->cpu, cpu);
+
+		mc->cyc = memvote_counter(cpu, M1_PMU_CORE_ACTIVE_CYCLE);
+		mc->miss = memvote_counter(cpu, M1_PMU_L1D_CACHE_MISS_LD);
+		if (!mc->cyc || !mc->miss)
+			mv->have_pmu = false;
+	}
+	if (!mv->have_pmu)
+		dev_warn(dev, "CPU PMU counters unavailable: auto mode will not request bandwidth\n");
+
+	platform_set_drvdata(pdev, mv);
+	INIT_DELAYED_WORK(&mv->work, memvote_work);
+	queue_delayed_work(system_freezable_wq, &mv->work, 1);
+	mutex_lock(&memvote_active_lock);
+	memvote_active = mv;
+	mutex_unlock(&memvote_active_lock);
+	dev_info(dev, "%u clusters, mode %s\n", mv->n_cl, memvote_modes[READ_ONCE(mode)]);
+	return 0;
+}
+
+static void memvote_stop(struct memvote *mv)
+{
+	unsigned int i;
+
+	cancel_delayed_work_sync(&mv->work);
+	mutex_lock(&mv->lock);
+	for (i = 0; i < mv->n_cl; i++)
+		memvote_set(mv, &mv->cl[i], false);
+	mutex_unlock(&mv->lock);
+}
+
+static void memvote_remove(struct platform_device *pdev)
+{
+	struct memvote *mv = platform_get_drvdata(pdev);
+
+	mutex_lock(&memvote_active_lock);
+	memvote_active = NULL;
+	mutex_unlock(&memvote_active_lock);
+
+	memvote_stop(mv);
+	memvote_free(mv);
+}
+
+static void memvote_shutdown(struct platform_device *pdev)
+{
+	struct memvote *mv = platform_get_drvdata(pdev);
+
+	if (mv)
+		memvote_stop(mv);
+}
+
+static struct platform_driver memvote_driver = {
+	.probe = memvote_probe,
+	.remove = memvote_remove,
+	.shutdown = memvote_shutdown,
+	.driver = {
+		.name = "apple-cpu-memvote",
+		.dev_groups = memvote_groups,
+	},
+};
+module_platform_driver(memvote_driver);
+
+MODULE_ALIAS("platform:apple-cpu-memvote");
+MODULE_SOFTDEP("pre: apple-soc-cpufreq");
+MODULE_DESCRIPTION("Apple SoC CPU cluster memory-bandwidth votes");
+MODULE_LICENSE("Dual MIT/GPL");
-- 
