From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: aquarat <3090997+aquarat@users.noreply.github.com>
Date: Wed, 18 Nov 2026 14:33:27 +0000
Subject: [PATCH 35/37] dt-bindings: power: apple: Add the PMP power state
 report

Document the PMP power state report node and its entries, as Asahi's
device trees already use them (apple,t6000-pmp-v2-report and friends),
and add apple,report-while-bound and apple,report-settle-ms for entries
that follow a device's driver instead of a power domain. The next patch
implements them.

Assisted-by: Claude:claude-opus-5-5
Signed-off-by: aquarat <3090997+aquarat@users.noreply.github.com>
---
 .../bindings/power/apple,pmp-report.yaml      | 149 ++++++++++++++++++
 1 file changed, 149 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/power/apple,pmp-report.yaml

diff --git a/Documentation/devicetree/bindings/power/apple,pmp-report.yaml b/Documentation/devicetree/bindings/power/apple,pmp-report.yaml
new file mode 100644
index 000000000..c93a0b30c
--- /dev/null
+++ b/Documentation/devicetree/bindings/power/apple,pmp-report.yaml
@@ -0,0 +1,149 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/power/apple,pmp-report.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple SoC PMP power state report
+
+maintainers:
+  - Sven Peter <sven@kernel.org>
+  - Janne Grunau <j@jannau.net>
+
+description: |
+  On Apple SoCs with a power management coprocessor (PMP), SoC blocks
+  report their power state to the PMP through a shared memory window (the
+  PMP "dashboard"). Each report entry is one bit, the block's PMP device id
+  minus one, in the dashboard's power state request and acknowledge words.
+
+  Most entries are power domains: a block is reported on while its power
+  domain is on. An entry with apple,report-while-bound is not a power
+  domain. It reports its block on only while the driver of the device it
+  names is bound, for blocks that must not be reported before their own
+  firmware runs (on t6000/t6001, the GPU).
+
+properties:
+  compatible:
+    items:
+      - enum:
+          - apple,t6000-pmp-v2-report
+          - apple,t6020-pmp-v2-report
+          - apple,t6030-pmp-v2-report
+          - apple,t8112-pmp-v2-report
+          - apple,t8122-pmp-v2-report
+
+  reg:
+    maxItems: 1
+
+  power-domains:
+    maxItems: 1
+
+  '#address-cells':
+    const: 1
+
+  '#size-cells':
+    const: 0
+
+patternProperties:
+  '^report@[0-9a-f]+$':
+    type: object
+    additionalProperties: false
+
+    properties:
+      compatible:
+        oneOf:
+          - const: apple,t6000-pmp-v2-report-entry
+          - items:
+              - enum:
+                  - apple,t8112-pmp-v2-report-entry
+              - const: apple,t6000-pmp-v2-report-entry
+
+      reg:
+        maxItems: 1
+        description: The entry's bit, which is the block's PMP device id minus one.
+
+      label:
+        description: Name of the power domain.
+
+      '#power-domain-cells':
+        const: 0
+
+      power-domains:
+        description: The block's PMGR power domain(s); parents of this entry.
+
+      apple,always-on:
+        type: boolean
+        description: Report the block on from probe and keep it on.
+
+      apple,report-while-bound:
+        $ref: /schemas/types.yaml#/definitions/phandle
+        description:
+          The device whose driver's lifetime the report follows. The block is
+          reported on after that driver has bound (and the PMP runs), off when
+          it starts to unbind, across system sleep and at shutdown. Such an
+          entry is not a power domain.
+
+      apple,report-settle-ms:
+        description:
+          Time to wait after the driver of apple,report-while-bound has bound
+          before reporting the block on.
+        default: 0
+
+      status: true
+
+    required:
+      - compatible
+      - reg
+
+    allOf:
+      - if:
+          required:
+            - apple,report-while-bound
+        then:
+          properties:
+            '#power-domain-cells': false
+            power-domains: false
+            apple,always-on: false
+        else:
+          properties:
+            apple,report-settle-ms: false
+          required:
+            - label
+            - '#power-domain-cells'
+
+required:
+  - compatible
+  - reg
+  - '#address-cells'
+  - '#size-cells'
+
+additionalProperties: false
+
+examples:
+  - |
+    soc {
+        #address-cells = <2>;
+        #size-cells = <2>;
+
+        pmp_report: pmp_report@28e3c0000 {
+            compatible = "apple,t6000-pmp-v2-report";
+            reg = <0x2 0x8e3c0000 0x0 0x20000>;
+            #address-cells = <1>;
+            #size-cells = <0>;
+
+            pmp_report_gfx: report@9 {
+                compatible = "apple,t6000-pmp-v2-report-entry";
+                reg = <0x9>;
+                label = "pmp-gfx";
+                apple,report-while-bound = <&gpu>;
+            };
+
+            pmp_report_ane_sys: report@a {
+                compatible = "apple,t6000-pmp-v2-report-entry";
+                reg = <0xa>;
+                label = "pmp-ane-sys";
+                #power-domain-cells = <0>;
+                power-domains = <&ps_ane_sys>;
+            };
+        };
+    };
-- 
