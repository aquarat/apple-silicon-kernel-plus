# SPDX-License-Identifier: GPL-2.0-only
# @asahi's config choices, applied to Fedora's configs: kernel-s390x-*-fedora.config.
# This is the difference between the configs of @asahi's kernel-7.1.13-402.asahi.fc44
# and Fedora's kernel-7.1.13-200.fc44 SRPM (scripts/kernel-configs.py diff), unchanged.
# Do not edit by hand; this project's own choices go in plus-s390x.config.
# CONFIG_APPLE_PLATFORMS is not set
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BT_BRCMEXT=y
CONFIG_DRM_PANIC_SCREEN_QR_CODE_URL=""
# CONFIG_SPI_HID_APPLE_OF is not set
# CONFIG_TOUCHSCREEN_APPLE_Z2 is not set
CONFIG_USB_XHCI_PCI_ASMEDIA=y
