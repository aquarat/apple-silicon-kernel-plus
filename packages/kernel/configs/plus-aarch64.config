# SPDX-License-Identifier: GPL-2.0-only
# This project's config choices for kernel-aarch64-*-fedora.config, applied
# after asahi-aarch64.config (scripts/kernel-configs.py). packages/kernel/README.md
# (Configs) explains each entry.

# Thunderbolt/USB4 on Apple silicon (the Asahi tree's series), as modules.
CONFIG_USB4_APPLE_SOC=m
CONFIG_RESET_APPLE_CIO=m
# Debug and test options of the lab kernel stay off here.
# CONFIG_USB4_DEBUGFS_WRITE is not set
# CONFIG_USB4_DMA_TEST is not set

# PCIe over Thunderbolt/USB4 on M1 Pro/Max/Ultra (patches 0010-0013,
# github.com/aquarat/apple-silicon-thunderbolt-linux).
CONFIG_PCIE_APPLE_APCIEC=m

# Fabric/DRAM requests to the PMP (patches 0030-0034): the interconnect
# provider is built in (consumers hold paths into it); the CPU clusters'
# memory-bandwidth votes are a module, loaded by its platform alias.
CONFIG_INTERCONNECT_APPLE_PMP=y
CONFIG_APPLE_CPU_MEMVOTE=m

# New in the Asahi 7.3.4 tree (201be96df565): the MSR scaler/colour-space
# converter (M2M V4L2 driver for Apple hardware), as a module like the
# other Apple media drivers.
CONFIG_VIDEO_APPLE_MSR=m
