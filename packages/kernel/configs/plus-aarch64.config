# SPDX-License-Identifier: GPL-2.0-only
# This project's config choices for kernel-aarch64-*-fedora.config, applied
# after asahi-aarch64.config (scripts/kernel-configs.py). packages/kernel/README.md
# (Configs) explains each entry.

# Thunderbolt/USB4 on Apple silicon (the Asahi tree's series), as modules.
CONFIG_USB4_APPLE_SOC=m
CONFIG_RESET_APPLE_CIO=m
# Debug and test options of the lab kernel stay off here.
# CONFIG_USB4_DEBUGFS_WRITE is not set
# CONFIG_USB4_DMA_TEST is not set
