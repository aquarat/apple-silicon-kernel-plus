#!/bin/bash
# SPDX-License-Identifier: GPL-2.0-only
# Load the Apple AVE encoder (apple-ave.service), unload it, or show its state.
# EXPERIMENTAL: see /usr/share/doc/apple-ave/README.md.
#
#   ave-load            load the SoC's overlay, then apple-ave; wait for /dev/videoN
#   ave-load unload     unload apple-ave (the overlay stays: it cannot be removed)
#   ave-load status
#   ave-load modprobe-hook [options]
#                       used by /usr/lib/modprobe.d/apple-ave.conf: lets only
#                       this script load ave-overlay
#
# Per SoC (the root node's first "apple,tNNNN" compatible):
#   t6000 (M1 Pro)    overlay variant=8, firmware H13S
#   t8103 (M1)        overlay variant=9, firmware H13G; H.264 is limited to
#                     I and P frames on this SoC (the driver enforces it)
#   t8112 (M2)        overlay variant=10, firmware H14G
#   t6001 (M1 Max)    overlay variant=7, firmware H13C; only with
#                     /etc/apple-ave/allow-t6001 (needs an m1n1 that programs
#                     the encoder's DAPF; see the README)
#   t6002 (M1 Ultra)  overlay variant=11, firmware H13D; only with
#                     /etc/apple-ave/allow-t6002 (the firmware placement is
#                     per machine; see the README)
#   anything else     no port yet: exits 0 without loading anything
set -u
LOG() { echo "ave-load: $*"; }
NODES='^apple-ave[0-9]?-enc$'
FW=/lib/firmware

case "${1:-}" in
modprobe-hook)
    shift
    if [ "${APPLE_AVE_LOAD:-}" != 1 ]; then
        echo "ave-overlay: refused; apple-ave.service loads it (ave-load)" >&2
        exit 1
    fi
    exec /usr/sbin/modprobe --ignore-install ave_overlay "$@"
    ;;
status)
    lsmod | grep -E '^(apple_ave|ave_overlay) ' || echo "not loaded"
    for n in /sys/class/video4linux/video*/name; do
        grep -qE "$NODES" "$n" 2>/dev/null && echo "$(cat "$n"): /dev/$(basename "$(dirname "$n")")"
    done
    exit 0
    ;;
unload)
    lsmod | grep -q '^apple_ave ' || { LOG "apple-ave is not loaded"; exit 0; }
    modprobe -r apple_ave && LOG "apple-ave unloaded"
    exit $?
    ;;
"") ;;
*) echo "usage: $0 [unload | status]" >&2; exit 2 ;;
esac

soc=$(tr '\0' '\n' < /proc/device-tree/compatible | grep -m1 -E '^apple,t[0-9]+$' | cut -d, -f2)
osfw=$(tr -d '\0' < /proc/device-tree/chosen/asahi,os-fw-version 2>/dev/null)
case "$soc" in
t6000) variant=8;  fw=apple/ave_h13s.bin; pristine=apple/ave-13.5-h13s-data-pristine.bin; want=1 ;;
t8103) variant=9;  fw=apple/ave_h13g.bin; pristine=apple/ave-13.5-h13g-data-pristine.bin; want=1 ;;
t8112) variant=10; fw=apple/ave_h14g.bin; pristine=apple/ave-13.5-h14g-data-pristine.bin; want=1 ;;
t6001) variant=7;  fw=apple/ave_h13c.bin; pristine=apple/ave-13.5-data-pristine.bin;      want=2 ;;
t6002) variant=11; fw=apple/ave_h13d.bin; pristine=apple/ave-13.5-h13d-data-pristine.bin; want=1 ;;
*) LOG "no AVE support for SoC '${soc:-unknown}'; nothing to do"; exit 0 ;;
esac
case "$soc" in
t6001|t6002)
    [ -e "/etc/apple-ave/allow-$soc" ] || {
        LOG "$soc needs per-machine preparation first (README); not loading"; exit 0; } ;;
esac

# The driver's firmware placement and DATA are those of the macOS 13.5
# system firmware that Asahi's installer sets up. Other versions are refused.
if [ "$osfw" != 13.5 ]; then
    LOG "os-fw-version is '${osfw:-unknown}'; only 13.5 is supported; not loading"
    exit 0
fi
for f in $fw $pristine; do
    [ -s "$FW/$f" ] || { LOG "missing $FW/$f (see the README: firmware); not loading"; exit 0; }
done

lsmod | grep -q '^apple_ave ' && { LOG "apple-ave is already loaded"; exec "$0" status; }

modprobe -a videodev v4l2-mem2mem videobuf2-common videobuf2-v4l2 videobuf2-dma-contig || exit 1
if ! lsmod | grep -q '^ave_overlay '; then
    APPLE_AVE_LOAD=1 modprobe ave_overlay variant="$variant" || { LOG "the overlay failed to load"; exit 1; }
fi
modprobe apple_ave || { LOG "apple-ave failed to load; see dmesg"; exit 1; }

n=0
for _ in $(seq 1 100); do
    n=$(grep -lE "$NODES" /sys/class/video4linux/video*/name 2>/dev/null | wc -l)
    [ "$n" -ge "$want" ] && { LOG "loaded ($soc, variant=$variant)"; exec "$0" status; }
    sleep 0.1
done
LOG "apple-ave loaded, but only $n of $want encoder node(s) appeared; see dmesg"
exit 1
