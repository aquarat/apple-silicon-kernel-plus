class Plan:
    def __init__(self, soc, known, dest):
        if soc not in SOCS:
            raise Refused(f"no AVE support for SoC {soc!r} (supported: {', '.join(sorted(SOCS))})")
        self.soc = soc
        self.s = SOCS[soc]
        self.known = known
        self.dest = dest
        self.ave_key = "ipsw:" + ave_member(self.s["variant"])
        self.kc_key = "ipsw:" + self.s["kc"]
        for k in (self.ave_key, self.kc_key):
            if k not in known or known[k][1] is None:
                raise Refused(f"known-hashes.txt has no size and sha256 for {k}")
        self.image = image_name(self.s["variant"])
        self.dpe = G.dpe_file_name(self.s["dpe"])
        self.built = self.s["pristine"][0] if self.s.get("built") else None
        self.outputs = [self.image, self.dpe] + ([self.built] if self.built else [])
        self.captured = [] if self.built else sorted(set(self.s["pristine"].values()))

    def path(self, p):
        return os.path.join(self.dest, p)

    def installed(self):
        """{path: state}: 'ok' | 'absent' | 'MISMATCH' for made files; for the
        captured blobs 'ok' (checked against the image) | 'not yet' | 'INVALID'."""
        out = {}
        for p in self.outputs:
            f = self.path(p)
            if not os.path.exists(f):
                out[p] = "absent"
            else:
                out[p] = "ok" if sha256(read_file(f)) == self.known.get(p, ("",))[0] else "MISMATCH"
        for inst, p in sorted(self.s["pristine"].items()):
            if p in out:
                continue
            f = self.path(p)
            if not os.path.exists(f):
                out[p] = "not yet"
                continue
            try:
                G.check_pristine(read_file(self.path(self.image)), read_file(f), self.soc, inst)
                out[p] = "ok"
            except (Refused, OSError):
                out[p] = "INVALID"
        return out

    def complete(self, state=None):
        state = state or self.installed()
        return all(state[p] == "ok" for p in self.outputs)

    def describe(self, source, local_kc):
        s = self.s
        ave_size = self.known[self.ave_key][1]
        kc_size = self.known[self.kc_key][1]
        lines = [f"SoC {self.soc} ({s['name']}): AVE firmware {s['variant']}, DPE tunables "
                 f"{s['dpe']}, from macOS {IPSW_VERSION} ({IPSW_BUILD})"]
        if local_kc:
            lines.append(f"Kernelcache: {local_kc} (on this machine; no download)")
        if source["kind"] == "url":
            need = [f"{ave_member(s['variant'])} (at most {human(ave_size)}; stored compressed)"]
            if not local_kc:
                need.append(f"{s['kc']} ({human(kc_size)})")
            lines += ["Source: Apple's restore image, read in place with HTTP range requests:",
                      f"  {source['where']}",
                      "Download: " + " and ".join(need) +
                      f", plus the image's zip directory (about 0.2 MB); not the whole "
                      f"{human(IPSW_SIZE)} image"]
        elif source["kind"] == "ipsw":
            lines.append(f"Source: the local IPSW {source['where']}")
        else:
            lines.append(f"Source: the files under {source['where']}")
        lines.append("Checks: every Apple file and every file made from it, against "
                     "known-hashes.txt (sha256)")
        lines.append("Writes: " + ", ".join(self.path(p) for p in self.outputs))
        if self.captured:
            lines.append("Later: the pristine DATA blob, which the driver keeps at its first "
                         "load of a boot (--capture; ave-load runs it)")
        return "\n".join(lines)


