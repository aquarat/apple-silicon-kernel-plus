def dt_strings(path):
    try:
        with open(path, "rb") as f:
            return [s.decode("ascii", "replace") for s in f.read().split(b"\0") if s]
    except OSError:
        return []


def detect():
    """(soc, board, os-fw-version) from the device tree; None where unknown."""
    compat = dt_strings(os.path.join(DT, "compatible"))
    soc = next((c.split(",", 1)[1] for c in compat
                if c.startswith("apple,t") and c[7:].isdigit()), None)
    board = next((c.split(",", 1)[1] for c in compat
                  if c.startswith("apple,j")), None)
    fw = dt_strings(os.path.join(DT, "chosen", "asahi,os-fw-version"))
    return soc, board, (fw[0] if fw else None)


def human(n):
    for unit in ("bytes", "KB", "MB", "GB"):
        if n < 1000 or unit == "GB":
            return f"{n} {unit}" if unit == "bytes" else f"{n:.1f} {unit}"
        n /= 1000.0
    return str(n)


def read_file(path, limit=256 * 1024 * 1024):
    with open(path, "rb") as f:
        return f.read(limit)


