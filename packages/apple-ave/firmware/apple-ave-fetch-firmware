# ---------------------------------------------------------------------------
# known-hashes.txt: "sha256  path  [size=N]  comment". Paths under apple/ are
# installed files; "ipsw:<member>" lines are IPSW members (with their size).
# ---------------------------------------------------------------------------
def load_hashes(path):
    known = {}
    with open(path, encoding="utf-8") as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            parts = line.split()
            if len(parts) < 2 or len(parts[0]) != 64:
                raise ValueError(f"{path}: malformed line: {line!r}")
            int(parts[0], 16)
            size = None
            for p in parts[2:]:
                if p.startswith("size="):
                    size = int(p[5:])
            known[parts[1]] = (parts[0].lower(), size)
    return known


def sha256(b):
    return hashlib.sha256(b).hexdigest()


def check_hash(known, path, data, what=None):
    """Raise Refused unless sha256(data) is the one listed for path."""
    if path not in known:
        raise Refused(f"{path} is not listed in known-hashes.txt")
    want, size = known[path]
    have = sha256(data)
    if size is not None and len(data) != size:
        raise Refused(f"{what or path}: {len(data)} bytes, expected {size}")
    if have != want:
        raise Refused(f"{what or path}: sha256 {have}, expected {want}")
    return have


def inner_im4p(buf):
    """The IM4P inside an IMG4 (a personalized copy on a Preboot volume), or buf."""
    tag, vs, ve = G.der_read(buf, 0)
    kids = G.der_children(buf, vs, ve)
    if kids and kids[0][0] == 0x16 and buf[kids[0][2]:kids[0][3]] == b"IMG4" and len(kids) > 1:
        return bytes(buf[kids[1][1]:kids[1][3]])
    return bytes(buf)


# ---------------------------------------------------------------------------
# A ZIP reader over any random-access source: a local file, or HTTP range
# requests. Only what an IPSW uses: ZIP64, stored or deflated members.
# ---------------------------------------------------------------------------
class FileSource:
    def __init__(self, path):
        self.path = path
        self.f = open(path, "rb")
        self.f.seek(0, os.SEEK_END)
        self.size = self.f.tell()
        self.fetched = 0

    def read(self, off, n):
        self.f.seek(off)
        b = self.f.read(n)
        if len(b) != n:
            raise Refused(f"{self.path}: short read at {off}")
        self.fetched += n
        return b

    def close(self):
        self.f.close()


class HTTPSource:
    """Range requests with retries: Apple's CDN drops long range sessions."""

    def __init__(self, url, retries=5, timeout=60, log=None):
        self.url = url
        self.retries = retries
        self.timeout = timeout
        self.fetched = 0
        self.log = log or (lambda m: None)
        self.size = self._size()

    def _open(self, rng):
        req = urllib.request.Request(self.url, headers={
            "Range": rng, "User-Agent": f"apple-ave-fetch-firmware/{VERSION}"})
        return urllib.request.urlopen(req, timeout=self.timeout)

    def _retry(self, what, fn):
        delay = 2
        for attempt in range(1, self.retries + 1):
            try:
                return fn()
            except (urllib.error.URLError, OSError, ConnectionError) as e:
                if isinstance(e, urllib.error.HTTPError) and e.code in (403, 404, 410):
                    raise Refused(f"{self.url}: HTTP {e.code}") from e
                if attempt == self.retries:
                    raise Refused(f"{what}: {e}") from e
                self.log(f"  {what}: {type(e).__name__}, retrying in {delay} s")
                time.sleep(delay)
                delay *= 2

    def _size(self):
        def go():
            with self._open("bytes=0-0") as r:
                cr = r.headers.get("Content-Range", "")
                if r.status != 206 or "/" not in cr:
                    raise Refused(f"{self.url}: the server does not answer range requests")
                return int(cr.rsplit("/", 1)[1])
        return self._retry("size of the image", go)

    def read(self, off, n):
        def go():
            with self._open(f"bytes={off}-{off + n - 1}") as r:
                if r.status != 206:
                    raise Refused(f"{self.url}: HTTP {r.status} to a range request")
                b = r.read()
            if len(b) != n:
                raise OSError(f"short range read ({len(b)} of {n} bytes)")
            return b
        b = self._retry(f"bytes {off}+{n}", go)
        self.fetched += n
        return b

    def close(self):
        pass


class ZipMember:
    __slots__ = ("name", "method", "csize", "usize", "crc", "lho")


class RemoteZip:
    EOCD = b"PK\x05\x06"
    Z64LOC = b"PK\x06\x07"
    Z64EOCD = b"PK\x06\x06"
    CDH = b"PK\x01\x02"
    LFH = b"PK\x03\x04"

    def __init__(self, src):
        self.src = src
        self.members = {}
        self.dir_bytes = 0
        self._read_directory()

    def _read_directory(self):
        s = self.src
        tail_n = min(s.size, 65536 + 22)
        tail = s.read(s.size - tail_n, tail_n)
        i = tail.rfind(self.EOCD)
        if i < 0 or i + 22 > len(tail):
            raise Refused("not a zip file (no end-of-directory record)")
        (_, disk, _, n_here, n_total, cd_size, cd_off, _) = struct.unpack_from(
            "<4sHHHHIIH", tail, i)
        if disk not in (0, 0xFFFF):
            raise Refused("multi-disk zip files are not supported")
        if 0xFFFFFFFF in (cd_size, cd_off) or 0xFFFF in (n_total,):
            j = i - 20
            if j < 0 or tail[j:j + 4] != self.Z64LOC:
                raise Refused("ZIP64 end-of-directory locator missing")
            z64_off = struct.unpack_from("<Q", tail, j + 8)[0]
            rec = s.read(z64_off, 56)
            if rec[:4] != self.Z64EOCD:
                raise Refused("bad ZIP64 end-of-directory record")
            n_total, cd_size, cd_off = struct.unpack_from("<QQQ", rec, 32)
        if cd_size > 64 * 1024 * 1024 or cd_off + cd_size > s.size:
            raise Refused("implausible zip directory")
        cd = s.read(cd_off, cd_size)
        self.dir_bytes = tail_n + cd_size
        off = 0
        for _ in range(n_total):
            if cd[off:off + 4] != self.CDH:
                raise Refused("bad zip directory entry")
            (method, crc, csize, usize, nlen, xlen, clen, lho) = struct.unpack_from(
                "<10xH4xIIIHHH8xI", cd, off)
            name = cd[off + 46:off + 46 + nlen].decode("utf-8", "replace")
            extra = cd[off + 46 + nlen:off + 46 + nlen + xlen]
            vals = {"usize": usize, "csize": csize, "lho": lho}
            x = 0
            while x + 4 <= len(extra):
                hid, hlen = struct.unpack_from("<HH", extra, x)
                if hid == 1:
                    k = x + 4
                    for f in ("usize", "csize", "lho"):
                        if vals[f] == 0xFFFFFFFF and k + 8 <= x + 4 + hlen:
                            vals[f] = struct.unpack_from("<Q", extra, k)[0]
                            k += 8
                x += 4 + hlen
            m = ZipMember()
            m.name, m.method, m.crc = name, method, crc
            m.csize, m.usize, m.lho = vals["csize"], vals["usize"], vals["lho"]
            self.members[name] = m
            off += 46 + nlen + xlen + clen

    def read(self, name, max_size=64 * 1024 * 1024):
        m = self.members.get(name)
        if m is None:
            raise Refused(f"the image has no member {name}")
        if m.usize > max_size or m.csize > max_size:
            raise Refused(f"{name}: implausible size {m.usize}")
        lfh = self.src.read(m.lho, 30)
        if lfh[:4] != self.LFH:
            raise Refused(f"{name}: bad local header")
        nlen, xlen = struct.unpack_from("<HH", lfh, 26)
        data = self.src.read(m.lho + 30 + nlen + xlen, m.csize)
        if m.method == 0:
            out = data
        elif m.method == 8:
            d = zlib.decompressobj(-15)
            out = d.decompress(data, m.usize + 1) + d.flush()
        else:
            raise Refused(f"{name}: zip method {m.method} is not supported")
        if len(out) != m.usize or zlib.crc32(out) & 0xFFFFFFFF != m.crc:
            raise Refused(f"{name}: size or CRC does not match the zip directory")
        return out


