def local_kernelcache(known):
    """A known 13.5 kernelcache on the EFI system partition (the Asahi
    installer's copy of this Mac's), or None. Any 13.5 kernelcache carries
    the same AppleAVE2.kext."""
    want = {known[k][0]: k for k in ("ipsw:" + n for n in KERNELCACHES) if k in known}
    for d in ESP_DIRS:
        for f in sorted(glob.glob(os.path.join(d, "kernelcache.release.*"))):
            try:
                if os.path.getsize(f) > 64 * 1024 * 1024:
                    continue
                if sha256(read_file(f)) in want:
                    return f
            except OSError:
                continue
    return None


def find_in_dir(root, names, max_depth=12):
    """Files under root whose name (lower case) is one of names."""
    names = {n.lower() for n in names}
    found = []
    root = os.path.abspath(root)
    base = root.count(os.sep)
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        if dirpath.count(os.sep) - base >= max_depth:
            dirnames[:] = []
        for fn in filenames:
            if fn.lower() in names:
                found.append(os.path.join(dirpath, fn))
    return sorted(found)


class Sources:
    """IPSW members (IM4P bytes) for a plan, each checked against its sha256."""

    def __init__(self, args, plan, log):
        self.args, self.plan, self.log = args, plan, log
        self.zip = None
        self.src = None

    def _zip(self):
        if self.zip is None:
            if self.args.ipsw:
                self.src = FileSource(self.args.ipsw)
            else:
                self.log(f"Reading the zip directory of {self.args.url}")
                self.src = HTTPSource(self.args.url, log=self.log)
            self.zip = RemoteZip(self.src)
        return self.zip

    def close(self):
        if self.src:
            self.log(f"  {human(self.src.fetched)} read from the image in total")
            self.src.close()

    def _from_dir(self, names, keys):
        want = {self.plan.known[k][0]: k for k in keys}
        reasons = []
        for c in find_in_dir(self.args.from_dir, names):
            try:
                b = inner_im4p(read_file(c))
            except (Refused, OSError) as e:
                reasons.append(f"{c}: {e}")
                continue
            if sha256(b) in want:
                self.log(f"  {c}: the {IPSW_VERSION} {want[sha256(b)][5:]}")
                return b
            reasons.append(f"{c}: not the macOS {IPSW_VERSION} file")
        raise Refused(f"none of {', '.join(names)} under {self.args.from_dir} is usable" +
                      ("".join("\n  " + r for r in reasons)))

    def _from_zip(self, key):
        member = key[5:]
        z = self._zip()
        m = z.members.get(member)
        if m is None:
            raise Refused(f"{member} is not in this image: is it macOS {IPSW_VERSION} ({IPSW_BUILD})?")
        if m.usize != self.plan.known[key][1]:
            raise Refused(f"{member} is {m.usize} bytes here, {self.plan.known[key][1]} in macOS "
                          f"{IPSW_VERSION}: not the expected image")
        self.log(f"Reading {member} ({human(m.csize)})")
        b = z.read(member, max_size=128 * 1024 * 1024)
        check_hash(self.plan.known, key, b, member)
        return b

    def ave_im4p(self):
        p = self.plan
        if self.args.from_dir:
            return self._from_dir([f"AppleAVE2FW_{p.s['variant']}.im4p", "AVE.img4"], [p.ave_key])
        return self._from_zip(p.ave_key)

    def kernelcache(self, local):
        p = self.plan
        keys = ["ipsw:" + n for n in KERNELCACHES if "ipsw:" + n in p.known]
        if local:
            b = read_file(local)
            self.log(f"Kernelcache: {local}")
            return b
        if self.args.from_dir:
            return self._from_dir(list(KERNELCACHES) + ["kernelcache"], keys)
        return self._from_zip(p.kc_key)


def make_files(plan, args, log, local_kc=None):
    """{path: bytes} for this SoC, every one checked. Nothing is written here."""
    src = Sources(args, plan, log)
    try:
        im4p = src.ave_im4p()
        kc_im4p = src.kernelcache(local_kc)
    finally:
        src.close()
    fourcc, image = im4p_payload(im4p)
    check_hash(plan.known, plan.image, image)
    log(f"  {plan.image}: sha256 OK")
    out = {plan.image: image}

    kc = G.Kernelcache(G.kernelcache_macho(kc_im4p))
    dpe = G.dpe_encode(G.dpe_tables(kc, plan.s["dpe"]))
    check_hash(plan.known, plan.dpe, dpe)
    log(f"  {plan.dpe}: {plan.s['dpe']} from AppleAVE2.kext, sha256 OK")
    out[plan.dpe] = dpe

    if plan.built:
        blob = G.build_pristine(image, plan.s["built"])
        check_hash(plan.known, plan.built, blob)
        log(f"  {plan.built}: built from the image, sha256 OK")
        out[plan.built] = blob
    return out


def install(files, dest, log):
    for p, b in files.items():
        f = os.path.join(dest, p)
        os.makedirs(os.path.dirname(f), exist_ok=True)
        fd, tmp = tempfile.mkstemp(dir=os.path.dirname(f), prefix=".apple-ave-")
        try:
            with os.fdopen(fd, "wb") as fh:
                fh.write(b)
            os.chmod(tmp, 0o644)
            os.replace(tmp, f)
        except BaseException:
            if os.path.exists(tmp):
                os.unlink(tmp)
            raise
        log(f"installed {f}")
    if dest == FIRMWARE_DIR and os.path.exists("/usr/sbin/restorecon"):
        os.system("/usr/sbin/restorecon -R " + os.path.join(dest, "apple") + " >/dev/null 2>&1")


def capture(plan, log, err, force=False):
    """Install the pristine DATA the driver kept this boot (debugfs)."""
    files = sorted(glob.glob(os.path.join(DEBUGFS, "apple_ave*_iboot_data")))
    if not files:
        err("nothing to capture: no apple_ave*_iboot_data in debugfs (the driver keeps "
            "DATA at its first load of a boot; is apple-ave loaded, debugfs mounted?)")
        return 1
    try:
        image = read_file(plan.path(plan.image))
        check_hash(plan.known, plan.image, image)
    except (OSError, Refused) as e:
        err(f"the firmware image is needed to check the copy: {e}")
        return 1
    out, rc = {}, 0
    for f in files:
        tail = os.path.basename(f)[len("apple_ave"):-len("_iboot_data")]
        inst = int(tail) if tail else 0
        name = plan.s["pristine"].get(inst)
        if not name or plan.built:
            continue
        try:
            blob = read_file(f)
            v = G.check_pristine(image, blob, plan.soc, inst)
        except (OSError, Refused) as e:
            err(f"{f}: {e}; not installed")
            rc = 1
            continue
        target = plan.path(name)
        if os.path.exists(target) and not force:
            try:
                G.check_pristine(image, read_file(target), plan.soc, inst)
                log(f"{target}: already in place and valid; kept")
                continue
            except (OSError, Refused):
                pass
        log(f"{f}: this boot's cold DATA (SOC_ {v['SOC_']:#x}, SOCR {v['SOCR']:#x}, "
            f"{v['tunables']} tunables), checked against the image")
        out[name] = blob
    if out:
        install(out, plan.dest, log)
    return rc


def parse_args(argv):
    ap = argparse.ArgumentParser(
        prog="apple-ave-fetch-firmware",
        description="Make the AVE encoder's firmware files for this Mac from Apple's macOS "
                    f"{IPSW_VERSION} files, verify them, and install them.",
        epilog="Nothing is downloaded or written without --yes or a 'y' at the prompt.")
    src = ap.add_mutually_exclusive_group()
    src.add_argument("--url", default=IPSW_URL, help="the IPSW URL (default: Apple's 13.5 image)")
    src.add_argument("--ipsw", metavar="FILE", help="a local copy of the 13.5 IPSW")
    src.add_argument("--from-dir", metavar="DIR",
                     help="search DIR for AppleAVE2FW_<variant>.im4p (or AVE.img4) and a "
                          "13.5 kernelcache (e.g. a mounted macOS 13.5 Preboot volume)")
    ap.add_argument("--soc", help="SoC to make the files for (default: this machine's)")
    ap.add_argument("--output-dir", metavar="DIR",
                    help=f"write the files under DIR/apple/ instead of {FIRMWARE_DIR}")
    ap.add_argument("--hashes", default=None, help="known-hashes.txt to use")
    ap.add_argument("--no-local-kernelcache", action="store_true",
                    help="do not use the kernelcache on the EFI system partition")
    ap.add_argument("-n", "--dry-run", action="store_true",
                    help="print the plan and exit; no network access, nothing written")
    ap.add_argument("-y", "--yes", action="store_true", help="do not ask for confirmation")
    ap.add_argument("--check", action="store_true",
                    help="report the installed files; exit 1 if any is missing or wrong")
    ap.add_argument("--capture", action="store_true",
                    help="install the pristine DATA blob the driver kept this boot")
    ap.add_argument("--force", action="store_true",
                    help="redo even if the files are in place, or the system firmware is not 13.5")
    ap.add_argument("-q", "--quiet", action="store_true", help="only print errors")
    ap.add_argument("--version", action="version", version=f"%(prog)s {VERSION}")
    return ap.parse_args(argv)


def default_hashes():
    here = os.path.dirname(os.path.abspath(__file__))
    for p in (HASHES, os.path.join(here, "known-hashes.txt")):
        if os.path.exists(p):
            return p
    return HASHES


def main(argv=None):
    a = parse_args(sys.argv[1:] if argv is None else argv)
    log = (lambda m: None) if a.quiet else (lambda m: print(m, flush=True))

    def err(m):
        print(f"apple-ave-fetch-firmware: {m}", file=sys.stderr, flush=True)

    try:
        known = load_hashes(a.hashes or default_hashes())
    except (OSError, ValueError) as e:
        err(f"cannot read known-hashes.txt: {e}")
        return 1

    soc, board, osfw = detect()
    if a.soc:
        soc = a.soc
    if not soc:
        err("cannot tell this machine's SoC from the device tree; give --soc")
        return 2
    dest = a.output_dir or FIRMWARE_DIR
    try:
        plan = Plan(soc, known, dest)
    except Refused as e:
        err(str(e))
        return 1

    if a.check:
        state = plan.installed()
        for p, st in state.items():
            print(f"{st:8s} {plan.path(p)}")
        return 0 if plan.complete(state) else 1

    if (a.capture or dest == FIRMWARE_DIR) and not a.dry_run and os.geteuid() != 0 \
            and not a.output_dir:
        err(f"run as root to install into {FIRMWARE_DIR} (or use --output-dir)")
        return 1

    if a.capture:
        return capture(plan, log, err, a.force)

    if not a.soc and osfw != IPSW_VERSION:
        msg = (f"this Mac's system firmware is {osfw or 'unknown'} "
               f"(asahi,os-fw-version), the driver supports {IPSW_VERSION} only")
        if not a.force:
            err(msg + "; nothing to do (--force makes the files anyway)")
            return 1
        log("warning: " + msg)

    source = ({"kind": "dir", "where": a.from_dir} if a.from_dir else
              {"kind": "ipsw", "where": a.ipsw} if a.ipsw else
              {"kind": "url", "where": a.url})
    if plan.complete() and not a.force:
        log(f"The {soc} files are installed and verified in {dest}; nothing to do.")
        return 0
    local_kc = None if (a.no_local_kernelcache or a.from_dir or a.ipsw) else local_kernelcache(known)
    log(plan.describe(source, local_kc))
    if board:
        log(f"This machine: {board}" + (f", system firmware {osfw}" if osfw else ""))
    if a.dry_run:
        log("Dry run: nothing downloaded or written.")
        return 0
    if not a.yes:
        if not sys.stdin.isatty():
            err("not on a terminal: rerun with --yes to proceed without asking")
            return 3
        try:
            ans = input("Proceed? [y/N] ").strip().lower()
        except EOFError:
            ans = ""
        if ans not in ("y", "yes"):
            log("Nothing done.")
            return 3
    try:
        files = make_files(plan, a, log, local_kc)
        install(files, dest, log)
    except Refused as e:
        err(f"{e}\nNothing was installed.")
        return 1
    except OSError as e:
        err(f"{e}\nNothing was installed (or only some files; rerun to finish).")
        return 1
    if dest == FIRMWARE_DIR:
        log("Done. Start the encoder with: sudo systemctl enable --now apple-ave.service")
    else:
        log(f"Done. To install these files later: sudo /usr/libexec/apple-ave/install-firmware {dest}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
